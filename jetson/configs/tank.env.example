# Copy target: /etc/tank/tank.env
# Values in this file are private. Never commit it.

# Bind to localhost unless another machine (such as the Flutter operator console)
# must reach this service through a protected network.
TANK_SERVER_HOST=127.0.0.1

# A compatible YOLOv5/v8 ONNX model. This repository intentionally contains no
# validated production detector.
TANK_MODEL_PATH=/opt/tank/ml/exports/detector.onnx

# Prefer this stable by-id path over /dev/video0, which can change after reboot.
TANK_CAM_FRONT_1_SOURCE=/dev/v4l/by-id/REPLACE_WITH_CAMERA_DEVICE
